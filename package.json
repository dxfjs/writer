{
  "name": "@tarikjabiri/dxf",
  "version": "3.0.0-alpha.14",
  "type": "module",
  "description": "A DXF writer written in TypeScript.",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxfjs/writer.git"
  },
  "author": "Tarik EL JABIRI",
  "license": "MIT",
  "homepage": "https://dxf.vercel.app",
  "bugs": {
    "url": "https://github.com/dxfjs/writer/issues",
    "email": "dxfjss@gmail.com"
  },
  "scripts": {
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "biome check",
    "examples": "bun run ./examples/index.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "commit": "cz"
  },
  "files": [
    "lib/**/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^22.20.3",
    "@types/opentype.js": "^1.3.10",
    "@vitest/coverage-v8": "^5.0.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1",
    "vue": "^3.5.42"
  },
  "funding": "https://github.com/sponsors/dxfjs",
  "keywords": [
    "js-dxf",
    "ts-dxf",
    "dxf",

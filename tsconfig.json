{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2015",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": {
      "DxfWriter": ["./src/DxfWriter"],
      "DxfDocument": ["./src/DxfDocument"],
      "Internals": ["./src/Internals/index"],
      "Sections": ["./src/Sections/index"],
      "Internals/*": ["./src/Internals/*"],
      "BlocksSection/*": ["./src/Sections/BlocksSection/*"],
      "ClassesSection/*": ["./src/Sections/ClassesSection/*"],
      "EntitiesSection/*": ["./src/Sections/EntitiesSection/*"],
      "HeaderSection/*": ["./src/Sections/HeaderSection/*"],
      "ObjectsSection/*": ["./src/Sections/ObjectsSection/*"],
      "TablesSection/*": ["./src/Sections/TablesSection/*"]
    }
  },
  "exclude": [
    "**/node_modules/**",
    "**/lib/**",
    "**/dist/**",
    "**/coverage/**",
    "**/examples/**",
    "./rollup.config.mjs"
  ],
  "include": ["./src", "./package.json", "specs"]
}
